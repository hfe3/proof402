NODE_ENV=development
PROOF402_PROFILE=demo
PORT=4022
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:4022

X402_ENABLED=false
X402_PRICE=$0.005
X402_NETWORK=eip155:84532
PAY_TO=

STORE_DRIVER=json
STORE_FILE=data/proof402-store.json

RECEIPT_KEY_ID=local-demo
RECEIPT_SECRET=development-only-proof402-receipt-secret

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
LOG_LEVEL=info
REQUEST_LOG_ENABLED=true

BETTER_STACK_LOGS_ENABLED=false
BETTER_STACK_INGEST_HOST=
BETTER_STACK_SOURCE_ID=
BETTER_STACK_SOURCE_TOKEN=
