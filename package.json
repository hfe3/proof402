{
  "name": "proof402",
  "version": "0.1.18",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "x402-compatible timestamped proof service for autonomous agents.",
  "homepage": "https://proof402.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/hfe3/proof402.git"
  },
  "bugs": {
    "url": "https://github.com/hfe3/proof402/issues"
  },
  "scripts": {
    "dev": "node src/server.js",
    "dev:demo": "node scripts/start-profile.js demo",
    "dev:testnet": "node scripts/start-profile.js testnet",
    "dev:mainnet": "node scripts/start-profile.js mainnet",
    "deploy:check": "node scripts/deploy-check.js",
    "local:doctor": "node scripts/local-doctor.js",
    "release:check": "node scripts/release-check.js",
    "security:scan": "node scripts/security-scan.js",
    "smoke:x402": "node scripts/x402-smoke.js",
    "start": "node src/server.js",
    "test": "node --import ./scripts/test-env.js --test test/api-contract.test.js test/proof.test.js test/store.test.js test/x402.test.js",
    "version:check": "node scripts/version-check.js",
    "verify:local": "node scripts/verify.js local",
    "verify:production": "node scripts/verify.js production"
  },
  "dependencies": {
    "@coinbase/x402": "latest",
    "@x402/core": "latest",
    "@x402/evm": "latest",
    "@x402/express": "latest",
    "dotenv": "latest",
    "express": "latest",
    "pg": "^8.20.0"
  }
}
