NODE_ENV=production
PROOF402_PROFILE=mainnet
PORT=4022
HOST=127.0.0.1
PUBLIC_BASE_URL=https://proof402.vercel.app

X402_ENABLED=true
X402_NETWORK=eip155:8453
X402_PRICE=$0.005
PAY_TO=0xYourReceivingWallet
FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

STORE_DRIVER=postgres
DATABASE_URL=postgres://user:password@host:5432/proof402
POSTGRES_SSL=true

RECEIPT_KEY_ID=default
RECEIPT_SECRET=replace-with-a-long-random-secret
# Optional key rotation map. Format: old-key-id:old-secret,older-key-id:older-secret
RECEIPT_PREVIOUS_SECRETS=

CDP_API_KEY_ID=replace-with-cdp-key-id
CDP_API_KEY_SECRET=replace-with-cdp-key-secret

# Optional operational limits
PROOF_RETENTION_MS=7776000000
MAX_METADATA_BYTES=8192
MAX_LABEL_LENGTH=120
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
LOG_LEVEL=info
REQUEST_LOG_ENABLED=true

# Optional Better Stack direct HTTP logging fallback.
# Keep token values only in local/Vercel env, never in Git.
BETTER_STACK_LOGS_ENABLED=false
BETTER_STACK_INGEST_HOST=s000000.eu-fsn-3.betterstackdata.com
BETTER_STACK_SOURCE_ID=0000000
BETTER_STACK_SOURCE_TOKEN=replace-with-better-stack-source-token
